{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "strict": true,
        "outDir": "public/src",
        "rootDir": "src/client",
        "sourceMap": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/client/**/*.ts"
    ]
}